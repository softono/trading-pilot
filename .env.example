# Public (browser-exposed)
NEXT_PUBLIC_APP_NAME=My App
NEXT_PUBLIC_BASE_URL=http://localhost:3035
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_UID=my-app
NEXT_PUBLIC_APP_TIMEZONE=UTC
NEXT_PUBLIC_APP_LOGO=logo.png
NEXT_PUBLIC_DEFAULT_IMAGE=no-image.jpg

# Server
NODE_ENV=development
APP_ENV=development
APP_DEBUG=true
CORS_ORIGIN=${NEXT_PUBLIC_BASE_URL}
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1

# 32 character
ENCRYPTION_KEY="secret-key"

# Database
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/dbname

# Cache (memory | redis | sqlite)
CACHE_DRIVER=sqlite
REDIS_URL=127.0.0.1:6379
# SQLite cache file (used when CACHE_DRIVER=sqlite)
CACHE_SQLITE_PATH=./storage/cache/cache.sqlite

# Google OAuth (social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Filesystem (local | s3)
FILESYSTEM_DISK=local
#Local storage (required when FILESYSTEM_DISK=local)
FILESYSTEM_PATH=./storage/
NEXT_PUBLIC_FILESYSTEM_URL=${NEXT_PUBLIC_BASE_URL}/storage
#NEXT_PUBLIC_FILESYSTEM_URL="https://${AWS_REGION}.s3.amazonaws.com/${AWS_BUCKET}"

# S3 / AWS (required when FILESYSTEM_DISK=s3)
AWS_REGION=us-east-1
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3-compatible endpoint, e.g. http://localhost:9000 for MinIO (optional)
AWS_ENDPOINT=

# Docker (docker-compose only — ignored outside Docker)
# Host port mapped to the app container
APP_PORT=3000
# Postgres container credentials; compose builds DATABASE_URL from these,
# overriding the value above inside the app container
DB_NAME=nextdemo
DB_USER=postgres
DB_PASS=postgres

IMGPROXY_ENABLED=false
IMGPROXY_KEY=
IMGPROXY_SALT=
IMGPROXY_URL="https://img.example.com"